# Copy this to functions/.env before deploying, then edit values.
# Firebase loads functions/.env at deploy time for Cloud Functions for Firebase.
TJF_SITE_URL=https://reekf.github.io/tjfweather
NWS_USER_AGENT=TJFWeather/1.0 (your-email@example.com)
TJF_APP_ID=tjf-weather-app
TJF_DEFAULT_TZ=America/Chicago
